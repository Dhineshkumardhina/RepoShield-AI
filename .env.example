# ==============================================================================
# RepoShield AI - Environment Configuration Template
# xerova Digital Solutions
# 
# SECURITY NOTICE:
# - Do NOT commit real secrets or production API keys to source control.
# - Copy this file to '.env' for local development:
#     PowerShell: Copy-Item .env.example .env
# ==============================================================================

# --- Application Core ---
APP_NAME="RepoShield AI"
APP_VERSION="0.1.0"
APP_ENV="development" # development | staging | production
DEBUG=true
ORGANIZATION="Xerova Digital Solutions"

# --- Backend Host & Network ---
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# --- Database Configuration ---
# Development: Local SQLite database
DATABASE_URL="sqlite:///./reposhield.db"
# Production Example (PostgreSQL):
# DATABASE_URL="postgresql+psycopg://reposhield_user:CHANGE_ME_PASSWORD@db-host:5432/reposhield_prod"

# --- CORS Allowed Origins (Comma-separated or JSON list) ---
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# --- Logging & Telemetry ---
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT_JSON=false # Set to true for JSON structured logging in production / ELK / Datadog

# --- Security & Cryptography ---
# Generate a cryptographically strong 32+ character key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY="dev-insecure-secret-key-replace-in-production!!"

# --- Optional AI Analyzer Key ---
# For server-side LLM triage enhancements (leave blank to run in deterministic synthetic mode)
# GEMINI_API_KEY=""
