name: "RepoShield AI Security Gate"

on:
  pull_request:
    branches: [ "main", "staging" ]
    types: [ opened, synchronize, reopened ]

# Strictly declare least-privilege permissions needed for this workflow
permissions:
  # Required to clone and read source code diff
  contents: read
  # Required to read pull request metadata (write only if publishing inline comments directly)
  pull-requests: write
  # Required if uploading SARIF report to GitHub Advanced Security tab
  security-events: write

concurrency:
  group: reposhield-${{ github.workflow }}-${{ github.head_ref || github.run_id }}
  cancel-in-progress: true

jobs:
  security-evaluation:
    name: "Evaluate Security Findings & Fixes"
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: "Checkout repository (shallow base & head)"
        uses: actions/checkout@v4
        with:
          fetch-depth: 0 # Full history needed for base commit correlation

      - name: "Set up Python Environment"
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: "pip"

      - name: "Install Security Scanners"
        run: |
          python -m pip install --upgrade pip
          python -m pip install semgrep bandit pip-audit

      - name: "Download Gitleaks (pinned release)"
        run: |
          GITLEAKS_VERSION="8.18.2"
          curl -sSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" -o gitleaks.tar.gz
          tar -xzf gitleaks.tar.gz gitleaks
          sudo mv gitleaks /usr/local/bin/
          rm -f gitleaks.tar.gz

      - name: "Identify Changed Files (Safe Bounding)"
        id: diff
        run: |
          # Retrieve changed files between PR base and head without untrusted shell expansion
          git diff --name-only origin/${{ github.base_ref }}...HEAD > changed_files.txt
          echo "AUDIT_CHANGED_COUNT=$(wc -l < changed_files.txt)" >> $GITHUB_ENV

      - name: "Execute Reproducible Scanners"
        id: scanners
        continue-on-error: true
        run: |
          mkdir -p .reposhield/reports

          echo "::group::Running Bandit (Python AST Analysis)"
          bandit -r . -f json -o .reposhield/reports/bandit.json --exclude "tests,venv,.venv" || true
          echo "::endgroup::"

          echo "::group::Running Semgrep (Rule Matching)"
          semgrep scan --config=auto --json -o .reposhield/reports/semgrep.json --exclude "tests" --quiet || true
          echo "::endgroup::"

          echo "::group::Running Gitleaks (Secret Detection)"
          gitleaks detect --redact --report-format json --report-path .reposhield/reports/gitleaks.json || true
          echo "::endgroup::"

          echo "::group::Running pip-audit (Software Supply Chain)"
          if [ -f "requirements.txt" ]; then
            pip-audit -r requirements.txt -f json -o .reposhield/reports/pip-audit.json || true
          fi
          echo "::endgroup::"

      - name: "Submit PR Analysis to RepoShield AI Gate"
        env:
          REPOSHIELD_BASE_URL: ${{ secrets.REPOSHIELD_SERVER_URL }}
          REPOSHIELD_API_KEY: ${{ secrets.REPOSHIELD_INGESTION_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: |
          if [ -z "$REPOSHIELD_BASE_URL" ] || [ -z "$REPOSHIELD_API_KEY" ]; then
            echo "::notice ::RepoShield server URL or API token not configured in repository secrets. Running in standalone local mode."
            exit 0
          fi

          # Safe submission without logging sensitive authorization tokens
          curl -s -S -X POST "${REPOSHIELD_BASE_URL}/api/v1/integrations/github/pr-scans" \
            -H "Authorization: Bearer ${REPOSHIELD_API_KEY}" \
            -H "Content-Type: application/json" \
            -d @- <<EOF
          {
            "pr_number": ${PR_NUMBER},
            "head_commit_sha": "${HEAD_SHA}",
            "base_commit_sha": "${BASE_SHA}",
            "pr_title": "PR #${PR_NUMBER}"
          }
          EOF

      - name: "Clean Artifacts (Prevent Credential Leakage in Workspace)"
        if: always()
        run: |
          rm -rf .reposhield/reports/*.json
